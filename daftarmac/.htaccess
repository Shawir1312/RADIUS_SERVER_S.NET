# MAC Registration — .htaccess
RewriteEngine On

# Deny access to sensitive files
<FilesMatch "\.(env|json|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to includes and data directories
<IfModule mod_rewrite.c>
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^data/ - [F,L]
</IfModule>
